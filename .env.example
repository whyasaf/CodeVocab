# ──────────────────────────────────────────────────────────────
# CodeVocab AI ayarları
# Bu dosyayı .env olarak kopyala ve EN AZ BİR anahtar doldur.
# Ne kadar çok anahtar eklersen o kadar "sınırsız" olur: biri kota
# hatası verince uygulama otomatik olarak sıradakine geçer.
# Groq, Gemini ve OpenRouter ücretsiz katman sunuyor. Cerebras artık sadece
# bir kerelik $5 deneme kredisi veriyor (sonrası ücretli).
# ──────────────────────────────────────────────────────────────

# https://console.groq.com/keys
# Bu tek anahtar iki sağlayıcıyı birden açar: "groq" (gpt-oss-120b) ve
# "groq-mini" (gpt-oss-20b, ayrı kota, son yedek).
GROQ_API_KEY=

# https://aistudio.google.com/apikey   (ücretsiz, önerilen ikinci anahtar)
GEMINI_API_KEY=

# https://openrouter.ai/settings/keys  (ücretsiz modeller, günlük istek sınırı düşük)
OPENROUTER_API_KEY=

# https://cloud.cerebras.ai  (sadece $5 deneme kredisi, sonrası ücretli)
CEREBRAS_API_KEY=

# İsteğe bağlı: deneme sırası (anahtarı boş olanlar atlanır)
# AI_PROVIDER_ORDER=groq,gemini,openrouter,cerebras,groq-mini

# İsteğe bağlı: model değiştirmek istersen (varsayılanlar ai.py içinde)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# CEREBRAS_MODEL=qwen-3.8-27b
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=openrouter/free
