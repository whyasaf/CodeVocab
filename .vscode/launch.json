{
  // F5: Flask'ı projenin sanal ortamıyla (.venv) başlatır → http://localhost:5050
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CodeVocab (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
